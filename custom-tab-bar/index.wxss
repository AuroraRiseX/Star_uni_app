/*
 * 自定义 TabBar - 适配所有 iOS 机型
 *
 * 关键修复：
 * 1. 使用 fixed 定位确保始终在底部
 * 2. JS 动态获取安全区高度（适配 Home Indicator）
 * 3. 统一使用 px 单位（safeBottom 是 px）
 */

.tab-bar {
  /* 固定定位 - 始终在屏幕底部 */
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  
  display: flex;
  justify-content: space-around;
  align-items: center;
  
  /* 内边距：上8px + 底部安全区由 JS 动态设置 */
  padding: 8px 0;
  
  /* 背景效果 */
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  
  /* 边框和阴影 */
  border-top: 1rpx solid rgba(229, 229, 229, 0.4);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  
  /* 层级 */
  z-index: 999;
  
  /* 盒模型 */
  box-sizing: border-box;
  width: 100%;
}

/* Tab Item */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  /* 尺寸 - 使用固定尺寸避免不同机型差异 */
  width: 64px;
  height: 56px;
  border-radius: 16px;
  
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

/* 激活状态背景色 */
.tab-item.active {
  background-color: #ffd93d;
}

/* 图标 */
.tab-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 2px;
}

/* 文字 */
.tab-text {
  font-size: 10px;
  font-weight: 700;
  color: #4d4633;
  letter-spacing: 0.02em;
}

/* 激活态文字颜色 */
.tab-item.active .tab-text {
  color: #725e00;
}

/*
 * 机型适配
 */

/* iPhone SE / 小屏设备 (宽度 < 375px) */
@media (max-width: 374px) {
  .tab-item {
    width: 56px;
    height: 50px;
    border-radius: 14px;
  }
  .tab-icon {
    width: 22px;
    height: 22px;
  }
  .tab-text {
    font-size: 9px;
  }
}

/* iPhone Pro Max / 大屏 (宽度 >= 430px) */
@media (min-width: 430px) {
  .tab-bar {
    padding-left: 24px;
    padding-right: 24px;
  }
  .tab-item {
    width: 72px;
    height: 60px;
  }
  .tab-icon {
    width: 26px;
    height: 26px;
  }
  .tab-text {
    font-size: 11px;
  }
}
