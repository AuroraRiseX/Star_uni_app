/**
 * 自定义底部导航栏样式
 * 1:1 复刻原型设计规格
 */

/* 底部导航栏容器 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 60;
  background: #ffffff;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 导航项 */
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
  min-width: 120rpx;
}

/* Active 状态背景 - secondary-container #fd8b17 */
.nav-item.active {
  background: #fd8b17;
}

/* 图标样式 - Material Symbols Outlined 24px */
.nav-icon {
  width: 48rpx;
  height: 48rpx;
  transition: all 0.2s ease;
}

/* 文字标签 - 12px, font-weight 700 */
.nav-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #4d4632;
  margin-top: 8rpx;
  letter-spacing: 0.05em;
  line-height: 1;
  transition: color 0.2s ease;
}

/* Active 文字颜色 - on-secondary-container #613100 */
.nav-item.active .nav-label {
  color: #613100;
}
