.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 8rpx 0;
  /*
   * 底部安全区：避让系统手势栏与 Home Indicator
   *  - constant 兼容 iOS < 11.2
   *  - env 兼容 iOS ≥ 11.2（含 iPhone X+ 全面屏）
   */
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(8rpx + constant(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(229, 229, 229, 0.5);
  box-shadow: 0 -20rpx 80rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 999;
  box-sizing: border-box;
  width: 100%;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.tab-item.active {
  background-color: #ffd93d;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-item.active .tab-icon {
  /* Active icon is the filled version */
}

.tab-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #4d4633;
}

.tab-item.active .tab-text {
  color: #725e00;
}
